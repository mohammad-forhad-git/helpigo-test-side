# Copy to .env and fill in real values. Never commit .env.
# Business values (fees, commission, limits) are NOT here: they live in site_settings, editable by admin.

APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # MUST be false in production
APP_URL=http://127.0.0.1:8090
APP_TIMEZONE=Asia/Dhaka

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=helpigo
DB_USER=helpigo_dev
DB_PASS=                      # wrap in quotes if it contains spaces or #

# Local only: wiped and rebuilt by tests/run.php. Must end with _test. Leave empty in production.
TEST_DB_NAME=helpigo_test

SESSION_NAME=hg_session
SESSION_SECURE_COOKIE=false   # true in production (HTTPS)
SESSION_IDLE_MINUTES=60       # admin inactivity logout

LOG_LEVEL=debug               # debug | info | warning | error

# SMS (OTP, task alerts). log = write to storage/logs/sms.log; http = provider (see app/services/SmsService.php)
SMS_DRIVER=log
# Example: https://provider.example/api/send?api_key={key}&senderid={sender}&number={to}&message={message}
SMS_API_URL=
SMS_API_METHOD=GET
SMS_API_KEY=
SMS_SENDER_ID=

# Staff alert email (new helpers, payments to verify, SOS)
OPS_EMAIL=

# Email to staff (alerts). smtp | mail | log
MAIL_DRIVER=log
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=""

UPLOAD_IMAGE_MAX_MB=4
